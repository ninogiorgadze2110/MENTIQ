# Normalize line endings: LF in the repository for text files.
* text=auto eol=lf

# Windows-oriented files keep CRLF.
*.ps1  text eol=crlf
*.sln  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts must stay LF.
*.sh   text eol=lf

# Binary assets.
*.ico  binary
*.png  binary
*.jpg  binary
*.woff binary
*.woff2 binary
