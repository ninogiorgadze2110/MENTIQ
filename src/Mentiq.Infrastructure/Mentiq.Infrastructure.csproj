<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Reference the shared ASP.NET Core framework so infrastructure can use
    IServiceCollection/DI extensions, IConfiguration, IOptions and the
    ASP.NET Core Identity PasswordHasher without pulling individual packages.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mentiq.Application\Mentiq.Application.csproj" />
    <ProjectReference Include="..\Mentiq.Domain\Mentiq.Domain.csproj" />
  </ItemGroup>

</Project>
